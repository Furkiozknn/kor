# Godot 4+ Ã¶zel
.godot/
/android/

# Disari aktarilan yapilar
# NOT: "build/" degil "build/*". Git yok saydigi DIZINE hic inmiyor,
# o yuzden dizinin kendisi yok sayilirken alttaki istisna calismaz.
build/*
# Godot'nun ciktilari yeniden ICE AKTARMASINI engelleyen isaret dosyasi
# depoda kalmali. Olmazsa .godot/ sisiyor ve gecmiste pck de sismisti;
# taze klonda kimse elle olusturmayi hatirlamaz.
!build/.gdignore
builds/
*.exe
*.pck
*.zip
*.apk
*.aab

# Isletim sistemi
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
*.tmp

# Yan oturumdan gelen, henuz baglanmamis varliklar (tuketilince silinecek)
_gelen/

# godot-mcp editor eklentisi -- yerel arac, npm paketinden yeniden kurulabilir
addons/godot_mcp/

# Test/arac ciktilari (ekran goruntusu, olcum raporu)
ciktilar/

# tests/web-dogrula.mjs playwright istiyor; "npm i --no-save playwright"
# buraya node_modules biraksin diye degil, depoya girmesin diye.
node_modules/
