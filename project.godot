; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Kor"
config/description="Kor - top-down roguelite. Ates isi biriktirir, dalis bosaltir, tavan asilirsa silah kilitlenir."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

general/default_playback_type.web=2
driver/mix_rate.web=48000

[autoload]

Hiss="*res://scripts/hiss.gd"
SesYonetici="*res://scripts/ses_yonetici.gd"
Kayit="*res://scripts/kayit.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray()

